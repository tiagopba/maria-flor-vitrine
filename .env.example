# ── Supabase ──────────────────────────────────────────────────────────────
# URL e chaves do projeto (Settings > API no dashboard do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor no navegador. Usada apenas em route handlers / server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────
# Opcional: só preencher quando o domínio próprio (ex: vitrine.modamariaflor.com.br)
# estiver configurado. Deixando em branco, o site usa a URL da Vercel automaticamente
# (ver src/lib/site.ts) — nenhum outro arquivo precisa mudar quando o domínio chegar.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME="Maria Flor"

# ── WhatsApp ──────────────────────────────────────────────────────────────
# Número padrão usado quando WHATSAPP_MODE=DEFAULT (formato internacional, só dígitos)
NEXT_PUBLIC_WHATSAPP_DEFAULT_NUMBER=

# ── Analytics (opcionais no MVP — deixar em branco desativa cada trilho) ──
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
